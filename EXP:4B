class Car:
    def __init__(self, car_number):
        self.car_number = car_number
        self.next = None


class ParkingQueue:
    def __init__(self):
        self.front = None
        self.rear = None

    def enqueue(self, car_number):
        new_car = Car(car_number)

        if self.rear is None:
            self.front = self.rear = new_car
            return

        self.rear.next = new_car
        self.rear = new_car

    def dequeue(self):
        if self.front is None:
            return None

        car_number = self.front.car_number
        self.front = self.front.next

        if self.front is None:
            self.rear = None

        return car_number

    def display(self):
        if self.front is None:
            print("Parking area is empty.")
            return

        current = self.front

        print("Cars in parking area:")
        while current:
            print("Car:", current.car_number)



parking = ParkingQueue()

while True:
    print("\n=== CAR PARKING MANAGEMENT ===")
    print("1. Park a car")
    print("2. Remove a car")
    print("3. Show parked cars")
    print("4. Exit")

    ch = int(input("Enter your choice: "))

    if ch == 1:
        car_number = input("Enter car number: ")
        parking.enqueue(car_number)
        print("Car parked successfully.")

    elif ch == 2:
        car_number = parking.dequeue()

        if car_number is None:
            print("Parking area is empty.")
        else:
            print("Car removed:", car_number)

    elif ch == 3:
        parking.display()

    elif ch == 4:
        print("Exiting...")
        break

    else:
        print("Invalid choice. Please try again.")
